[Unit]
Description=Cloudflare Tunnel for yato portfolio
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=simple
DynamicUser=yes
LoadCredential=tunnel-token:/etc/cloudflared/portfolio.token
Environment=TUNNEL_TOKEN_FILE=%d/tunnel-token
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
