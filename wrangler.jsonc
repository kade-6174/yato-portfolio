{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yato-portfolio",
  "main": "dist/server/index.js",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "yato-lab.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"]
}
